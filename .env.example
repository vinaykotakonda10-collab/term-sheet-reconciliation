# Copy this file to .env and fill in GROQ_API_KEY (https://console.groq.com/keys).
# .env is git-ignored; never commit a real key.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_TIMEOUT=60
GROQ_MAX_RETRIES=3

# Optional tuning (defaults shown)
# GROQ_REASONING_EFFORT=low        # low|medium|high for reasoning models; leave empty for non-reasoning models
# GROQ_TEMPERATURE=0
# EXTRACTION_MAX_CHARS=12000       # document text budget per extraction call (free tier: 8K tokens/min)
# EXTRACTION_MAX_TOKENS=4000
# ADJUDICATION_MAX_TOKENS=1500
# BOOKING_DATE_ORDER=auto          # auto|MDY|DMY for slash dates such as 10/14/2025
# LOG_LEVEL=INFO
